#define ZMK_POINTING_DEFAULT_MOVE_VAL 3100  // default: 600

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <150>;
    flavor = "balanced";
};

&mt {
    tapping-term-ms = <200>;
    flavor = "hold-preferred";
};

&mmv {
    time-to-max-speed-ms = <700>;
    acceleration-exponent = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";

        exlamation {
            bindings = <&kp LS(NUMBER_1)>;
            key-positions = <14 15 16>;
        };

        questionmark {
            bindings = <&kp LS(FSLH)>;
            key-positions = <38 39 40>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <>;
        };

        doublequote {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <19 20 21>;
        };

        singlequote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <45 46 47>;
        };

        homerow {
            bindings = <&kp LC(EQUAL)>;
            key-positions = <10 11>;
        };

        num-lock {
            bindings = <&to 1>;
            key-positions = <1 11>;
        };

        caps-lock {
            bindings = <&to 4>;
            key-positions = <2 11>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <43 30 18 6 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 45 46 47 48 49 56 57 44 55 54>;
            tapping-term-ms = <250>;
            hold-trigger-on-release;
            flavor = "hold-preferred";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            hold-trigger-on-release;
            flavor = "hold-preferred";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3            &kp N4             &kp N5                                         &kp N6     &kp N7              &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E             &kp R              &kp T                                          &kp Y      &kp U               &kp I      &kp O    &kp P     &kp SINGLE_QUOTE
&kp LCTRL  &kp A   &kp S   &kp D             &hml LEFT_SHIFT F  &kp G                                          &kp H      &hmr RIGHT_SHIFT J  &kp K      &kp L    &kp SEMI  &kp DELETE
&kp LSHFT  &kp Z   &kp X   &kp C             &kp V              &kp B         &kp K_MUTE     &kp C_PLAY_PAUSE  &kp N      &kp M               &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                           &kp LEFT_CONTROL  &kp LEFT_ALT       &kp LEFT_GUI  &lt 1 SPACE    &lt 2 BACKSPACE   &kp ENTER  &kp RGUI            &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        NUMNAV {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans                    &trans        &trans         &trans        &trans       &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp HOME      &kp PAGE_DOWN  &kp UP_ARROW  &kp PAGE_UP  &kp END        &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &kp LC(LEFT)  &kp LEFT       &kp DOWN      &kp RIGHT    &kp LC(RIGHT)  &trans
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans    &trans  &trans        &kp LG(Z)      &kp LG(X)     &kp LG(C)    &kp LG(V)      &trans
                        &trans  &trans  &trans  &trans    &mo 3   &trans        &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        SYMBOL {
            bindings = <
&trans  &kp F1         &kp F2      &kp F3         &kp F4        &kp F5                        &kp F6       &kp F7         &kp F8         &kp F9        &kp F10           &trans
&trans  &kp LS(MINUS)  &kp NUBS    &kp LS(NUBS)   &kp FSLH      &kp LS(N5)                    &kp LS(N6)   &kp MINUS      &kp LS(EQUAL)  &kp EQUAL     &kp LS(N8)        &kp LS(N2)
&trans  &kp LS(N7)     &kp LS(N9)  &kp LS(LBKT)   &kp LS(RBKT)  &kp LS(N0)                    &kp LS(SQT)  &kp RA(MINUS)  &kp GRAVE      &kp LS(NUHS)  &kp RA(LS(LBKT))  &trans
&trans  &kp NUHS       &kp LBKT    &kp LS(COMMA)  &kp LS(DOT)   &kp RBKT    &trans    &trans  &kp LS(N4)   &kp RA(N4)     &kp LS(N3)     &kp RA(Y)     &kp RA(LS(W))     &trans
                                   &trans         &trans        &trans      &mo 3     &trans  &trans       &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        MOUSE {
            bindings = <
&to 5   &trans  &trans            &trans           &trans       &trans                               &trans  &trans          &trans          &trans           &kp C_MUTE     &kp C_VOLUME_UP
&trans  &trans  &trans            &trans           &trans       &trans                               &trans  &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &kp LS(LG(N))  &kp C_VOLUME_DOWN
&trans  &trans  &trans            &trans           &trans       &trans                               &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans         &trans
&trans  &trans  &kp LG(LC(LEFT))  &kp LS(LC(TAB))  &kp LC(TAB)  &kp LG(LC(RIGHT))  &trans    &trans  &trans  &mkp LCLK       &mkp MCLK       &mkp RCLK        &trans         &trans
                                  &trans           &trans       &trans             &trans    &trans  &trans  &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        SHIFTED {
            bindings = <
&to 0   &kp N1     &kp N2     &kp N3            &kp N4        &kp N5                                         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS
&trans  &kp LS(Q)  &kp LS(W)  &kp LS(E)         &kp LS(R)     &kp LS(T)                                      &kp LS(Y)  &kp LS(U)  &kp LS(I)  &kp LS(O)  &kp LS(P)  &kp SINGLE_QUOTE
&trans  &kp LS(A)  &kp LS(S)  &kp LS(D)         &kp LS(F)     &kp LS(G)                                      &kp LS(H)  &kp LS(J)  &kp LS(K)  &kp LS(L)  &kp SEMI   &kp DELETE
&trans  &kp LS(Z)  &kp LS(X)  &kp LS(C)         &kp LS(V)     &kp LS(B)     &kp K_MUTE     &kp C_PLAY_PAUSE  &kp LS(N)  &kp LS(M)  &kp COMMA  &kp DOT    &kp FSLH   &kp RIGHT_SHIFT
                              &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 2 SPACE    &lt 3 BACKSPACE   &kp ENTER  &kp RGUI   &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        SYSTEM {
            bindings = <
&trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &trans             &trans  &trans  &trans  &trans  &trans
&bootloader  &trans        &trans        &trans        &trans        &trans                            &ext_power EP_ON   &trans  &trans  &trans  &trans  &bootloader
&trans       &trans        &trans        &trans        &trans        &trans                            &ext_power EP_TOG  &trans  &trans  &trans  &trans  &trans
&to 0        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans    &trans  &ext_power EP_OFF  &trans  &trans  &trans  &trans  &to 0
                                         &trans        &trans        &trans          &trans    &trans  &trans             &trans  &trans
            >;
        };
    };
};
